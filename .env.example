# Copia este archivo a .env y llena los valores reales. Nunca se comitea .env.

# --- Symphony.Node (apps/node-server) ---
ASPNETCORE_ENVIRONMENT=Development
SYMPHONY_NODE_SQLITE_PATH=./datos/nodo-de-prueba.sqlite
SYMPHONY_NODE_CLOUD_URL=https://nube.de-prueba.symphony.local
# La iglesia a la que sirve este nodo. La da el alta de la iglesia en la nube.
SYMPHONY_NODE_IGLESIA_ID=00000000-0000-7000-8000-000000000000

# --- Symphony.Cloud (services/cloud-api) ---
ASPNETCORE_ENVIRONMENT=Development
SYMPHONY_CLOUD_POSTGRES_CONNECTION_STRING=Host=localhost;Database=symphony_de_prueba;Username=usuario_de_prueba;Password=contrasena_de_prueba
