# Copia este archivo a .env y llena los valores reales. Nunca se comitea .env.

# --- Symphony.Node (apps/node-server) ---
ASPNETCORE_ENVIRONMENT=Development
SYMPHONY_NODE_SQLITE_PATH=./datos/nodo-de-prueba.sqlite
SYMPHONY_NODE_CLOUD_URL=https://nube.de-prueba.symphony.local
# La iglesia a la que sirve este nodo. La da el alta de la iglesia en la nube.
SYMPHONY_NODE_IGLESIA_ID=00000000-0000-7000-8000-000000000000
# Claves de firma de sesiones (Ed25519, base64). Las reales se generan con
# `dotnet run -- generar-claves`; estas son inservibles a propósito.
SYMPHONY_NODE_CLAVE_PRIVADA=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SYMPHONY_NODE_CLAVE_PUBLICA_NUBE=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Symphony.Cloud (services/cloud-api) ---
ASPNETCORE_ENVIRONMENT=Development
SYMPHONY_CLOUD_POSTGRES_CONNECTION_STRING=Host=localhost;Database=symphony_de_prueba;Username=usuario_de_prueba;Password=contrasena_de_prueba
# Rol symphony_propietario (BYPASSRLS). Solo lo usan los caminos listados en
# docs/operacion/roles-de-base-de-datos.md — hoy, el login.
SYMPHONY_CLOUD_POSTGRES_PROPIETARIO_CONNECTION_STRING=Host=localhost;Database=symphony_de_prueba;Username=propietario_de_prueba;Password=contrasena_de_prueba
# Clave privada de firma de la nube (Ed25519, base64). La real se genera con
# `dotnet run -- generar-claves`; esta es inservible a propósito.
SYMPHONY_CLOUD_CLAVE_PRIVADA=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
